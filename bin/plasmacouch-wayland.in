set -eu

# Source Bigscreen common environment
. plasma-bigscreen-common-env

# Launch Plasma Bigscreen Wayland session
exec startplasma-wayland --xwayland --libinput --exit-with-session="@KDE_INSTALL_FULL_LIBEXECDIR@/startplasma-waylandsession" "$@"