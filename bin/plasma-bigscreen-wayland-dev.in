set -eu

# Source development environment prefix
. "@CMAKE_INSTALL_FULL_LIBEXECDIR@/plasma-dev-prefix.sh"

# Development hack: because systemd starts in PAM before dev paths are configured,
# copy systemd user units to the transient runtime user.control directory and reload.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    mkdir -p "${XDG_RUNTIME_DIR}/systemd/user.control"
    if [ -d "@KDE_INSTALL_FULL_SYSTEMDUSERUNITDIR@" ]; then
        cp -r "@KDE_INSTALL_FULL_SYSTEMDUSERUNITDIR@"/* "${XDG_RUNTIME_DIR}/systemd/user.control" 2>/dev/null || true
    fi
    systemctl --user daemon-reload 2>/dev/null || true
fi

# Launch the Wayland session with forwarded arguments
exec plasma-bigscreen-wayland "$@"

