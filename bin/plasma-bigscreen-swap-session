set -eu

# Verify that current session is KDE Plasma
if [ "${XDG_CURRENT_DESKTOP:-}" != "KDE" ]; then
    echo "Error: This script can only be run on KDE Plasma." >&2
    exit 1
fi

CACHE_DIR="$HOME/.cache/plasma-bigscreen"
SAVED_ENV="$CACHE_DIR/saved-env"

mkdir -p "$CACHE_DIR"

swap_to_bigscreen() {
    # Save current environment for subsequent restoration
    export -p > "$SAVED_ENV"

    # Source Bigscreen common environment
    . plasma-bigscreen-common-env

    export PLASMA_BIGSCREEN_LAUNCH_REASON=swap

    # Start plasma-bigscreen-inputhandler in the background
    QT_QPA_PLATFORM=offscreen plasma-bigscreen-inputhandler &

    # Replace running plasmashell instance with Bigscreen shell
    plasmashell --replace &
}

swap_to_default() {
    # Restore saved environment if available
    if [ -f "$SAVED_ENV" ]; then
        . "$SAVED_ENV"
        rm -f "$SAVED_ENV"
    fi

    unset PLASMA_BIGSCREEN_LAUNCH_REASON || true

    # Gracefully stop plasma-bigscreen-inputhandler
    pkill -f plasma-bigscreen-inputhandler 2>/dev/null || true

    # Replace running plasmashell instance with default desktop shell
    plasmashell --replace &
}

# Toggle between Bigscreen shell and default Plasma desktop
if [ "${PLASMA_BIGSCREEN_LAUNCH_REASON:-}" = "swap" ]; then
    swap_to_default
else
    swap_to_bigscreen
fi

