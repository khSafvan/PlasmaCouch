set -eu

# Verify that current session is KDE Plasma
if [ "${XDG_CURRENT_DESKTOP:-}" != "KDE" ]; then
    echo "Error: This script can only be run on KDE Plasma." >&2
    exit 1
fi

CACHE_DIR="$HOME/.cache/plasmacouch"
SAVED_ENV="$CACHE_DIR/saved-env"

mkdir -p "$CACHE_DIR"

swap_to_plasmacouch() {
    # Save current environment for subsequent restoration
    export -p > "$SAVED_ENV"

    # Source PlasmaCouch common environment
    . plasmacouch-common-env

    export PLASMACOUCH_LAUNCH_REASON=swap

    # Start plasmacouch-inputhandler in the background
    QT_QPA_PLATFORM=offscreen plasmacouch-inputhandler &

    # Replace running plasmashell instance with PlasmaCouch shell
    plasmashell --replace &
}

swap_to_default() {
    # Restore saved environment if available
    if [ -f "$SAVED_ENV" ]; then
        . "$SAVED_ENV"
        rm -f "$SAVED_ENV"
    fi

    unset PLASMACOUCH_LAUNCH_REASON || true
    unset PLASMA_BIGSCREEN_LAUNCH_REASON || true

    # Gracefully stop plasmacouch-inputhandler
    pkill -f plasmacouch-inputhandler 2>/dev/null || true
    pkill -f plasma-bigscreen-inputhandler 2>/dev/null || true

    # Replace running plasmashell instance with default desktop shell
    plasmashell --replace &
}

# Toggle between PlasmaCouch shell and default Plasma desktop
if [ "${PLASMACOUCH_LAUNCH_REASON:-${PLASMA_BIGSCREEN_LAUNCH_REASON:-}}" = "swap" ]; then
    swap_to_default
else
    swap_to_plasmacouch
fi


